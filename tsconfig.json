{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "paths": {
      "@scribe/cli": ["packages/cli/index.js"],
      "@scribe/config": ["packages/config/index.js"],
      "@scribe/console": ["packages/console/index.js"],
      "@scribe/fs": ["packages/fs/index.js"],
      "@scribe/git": ["packages/git/index.js"],
      "@scribe/process": ["packages/process/index.js"],
      "@scribe/renderer": ["packages/renderer/index.js"],
      "@scribe/ui": ["packages/ui/index.js"],
      "@scribe/test": ["packages/test/*"]
    },
    "lib": ["ESNext"],
    "baseUrl": ".",
    "target": "ES2022",
    "esModuleInterop": true,
    // Eases ESM support
    "types": ["node", "vitest/globals"],
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "plugins": [
      {
        "name": "@effect/language-service"
      },
      {
        "name": "@unsplash/ts-namespace-import-plugin",
        "namespaces": {
          "Effect": {
            "importPath": "@effect/io/Effect"
          }
        }
      }
    ]
  },
  "include": [
    ".eslintrc.js",
    "packages",
    "src",
    "e2e",
    "vite.config.ts",
    "packages/cli/index.ts",
    "types",
    "tsup.config.ts",
    "test"
  ],
  "exclude": ["examples", "public", "dist", "scribe.config.ts"],
  "ts-node": {
    "swc": true,
    "require": ["tsconfig-paths/register"]
  }
}
