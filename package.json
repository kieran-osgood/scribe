{
  "name": "@kieran-osgood/scribe",
  "version": "0.4.1",
  "description": "Scribe is a file templating CLI based on Mustache Templates.",
  "private": false,
  "main": "dist/index.cjs",
  "module": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "scribe": "./dist/index.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kieran-osgood/scribe.git"
  },
  "homepage": "https://github.com/kieran-osgood/scribe/#readme",
  "bugs": "https://github.com/kieran-osgood/scribe/issues",
  "license": "MIT",
  "keywords": [
    "cli",
    "typescript"
  ],
  "scripts": {
    "start": "tsx packages/cli/index.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint .",
    "lint:watch": "esw .",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "tsc": "tsc",
    "tsc:watch": "tsc --watch",
    "build": "tsup packages/cli/index.ts",
    "publish": "changeset publish",
    "changeset": "changeset",
    "size": "pnpm run build && size-limit",
    "prepare": "husky install"
  },
  "dependencies": {
    "@effect/cli": "^0.46.0",
    "@effect/platform": "^0.67.0",
    "@effect/platform-node": "^0.62.0",
    "@effect/schema": "^0.75.0",
    "colorette": "^2.0.20",
    "cosmiconfig": "^9.0.0",
    "cosmiconfig-typescript-loader": "^5.0.0",
    "effect": "3.9.0",
    "simple-git": "^3.27.0",
    "template-file": "^6.0.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@effect/vitest": "^0.11.0",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.12.0",
    "@size-limit/file": "^11.1.6",
    "@swc/core": "^1.7.26",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/node20": "^20.1.4",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitest/coverage-istanbul": "^2.1.2",
    "@vitest/ui": "^2.1.2",
    "changeset": "^0.2.6",
    "eslint": "^9.12.0",
    "eslint-plugin-communist-spelling": "^1.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "fast-check": "^3.22.0",
    "globals": "^15.10.0",
    "husky": "^9.1.6",
    "npm-run-all": "^4.1.5",
    "prettier": "3.3.3",
    "size-limit": "^11.1.6",
    "tempy": "^3.1.0",
    "terser": "^5.34.1",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8",
    "vite-node": "^2.1.2",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "2.1.2"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "80 kb"
    }
  ],
  "prettier": {
    "semi": true,
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": true,
    "arrowParens": "avoid",
    "trailingComma": "all"
  }
}
